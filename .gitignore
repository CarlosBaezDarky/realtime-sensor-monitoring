# ============================================
# EXCEPCIONES ESPECÍFICAS DEL PROYECTO
# ============================================

# Mantener estos archivos
!config/development.yaml.example
!config/production.yaml.example
!config/testing.yaml.example
!.env.example

# Mantener estructura de directorios vacíos
!.gitkeep

# Mantener documentación
!docs/README.md
!docs/architecture.md
!docs/api.md

# Mantener ejemplos
!examples/
!examples/**/*.py
!examples/**/*.ipynb

# Mantener assets por defecto
!frontend/assets/
!frontend/assets/icons/default/
!frontend/assets/fonts/default/

# ============================================
# NOTAS PARA DESARROLLADORES
# ============================================
# 
# 1. Para ignorar archivos específicos temporalmente:
#    git update-index --assume-unchanged [archivo]
#    
# 2. Para ver archivos ignorados:
#    git status --ignored
#    
# 3. Para forzar agregar un archivo ignorado:
#    git add -f [archivo]
#    
# 4. Archivos que SI deben estar en el repositorio:
#    - Código fuente
#    - Documentación
#    - Configuraciones de ejemplo
#    - Scripts de utilidad
#    - Licencias
#    - READMEs
#
# 5. Archivos que NO deben estar en el repositorio:
#    - Credenciales/secretos
#    - Archivos de entorno (.env)
#    - Archivos de base de datos
#    - Binarios grandes
#    - Archivos de log
#    - Archivos de sistema
#
# ============================================